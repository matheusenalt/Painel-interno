# Exemplo estrutural. O .env real é gerado/restaurado localmente e NUNCA deve ir ao Git.
DEPLOY_PROFILE=prod
TZ=America/Sao_Paulo
HOST_IP=IP_LOCAL_DA_VPS
BIND_ADDRESS=127.0.0.1
NEXTCLOUD_PORT=8080
FOXDESK_PORT=8081
# Ex.: 34.x.y — informe a versão exata aprovada
NEXTCLOUD_VERSION=DEFINA_VERSAO_EXATA_APROVADA
# Ex.: 11.4.x — informe a versão/tag exata aprovada
MARIADB_VERSION=DEFINA_VERSAO_EXATA_APROVADA
# Ex.: 7.4.x-alpine — informe a versão/tag exata aprovada
REDIS_VERSION=DEFINA_VERSAO_EXATA_APROVADA
# Ex.: 0.3.x — informe a versão exata aprovada e calcule o SHA-256
FOXDESK_VERSION=DEFINA_VERSAO_EXATA_APROVADA
FOXDESK_SHA256=SHA256_DA_VERSAO_FOXDESK_APROVADA_AQUI
NC_DB_BUFFER_POOL=512M
NC_DB_MAX_CONNECTIONS=100
FOX_DB_BUFFER_POOL=256M
FOX_DB_MAX_CONNECTIONS=80
RELEASE_CHANNEL=production-rc
CONFIG_FILE=/opt/portal-interno/config/portal.json
NEXTCLOUD_DOMAIN=SEU_DOMINIO_NEXTCLOUD_AQUI
FOXDESK_DOMAIN=SEU_DOMINIO_FOXDESK_AQUI
NEXTCLOUD_PUBLIC_URL=https://SEU_DOMINIO_NEXTCLOUD_AQUI
FOXDESK_PUBLIC_URL=https://SEU_DOMINIO_FOXDESK_AQUI
NEXTCLOUD_ADMIN_USER=admin
NC_DB_NAME=nextcloud
NC_DB_USER=nextcloud
NC_DB_PASSWORD=GERADO_OU_RESTAURADO_LOCALMENTE
NC_DB_ROOT_PASSWORD=GERADO_OU_RESTAURADO_LOCALMENTE
REDIS_PASSWORD=GERADO_OU_RESTAURADO_LOCALMENTE
FOX_DB_NAME=foxdesk
FOX_DB_USER=foxdesk
FOX_DB_PASSWORD=GERADO_OU_RESTAURADO_LOCALMENTE
FOX_DB_ROOT_PASSWORD=GERADO_OU_RESTAURADO_LOCALMENTE
BACKUP_MODE=pull
BACKUP_SFTP_USER=backupreader
BACKUP_EXPORT_ROOT=/srv/portal-backup-sftp
KEEP_DAILY=1
KEEP_WEEKLY=0
RESTORE_UPLOAD_LIMIT=64G
RESTORE_UPLOAD_LIMIT_BYTES=68719476736
RESTORE_INBOX=/srv/portal-restore-inbox
RESTORE_TMP=/srv/portal-restore-tmp
PORTAL_CONTROL_GID=GERADO_LOCALMENTE
